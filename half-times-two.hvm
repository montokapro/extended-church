@id = (x x)

@succ = (n ({f0 f1} (x C)))
  & n ~ (f0 A)
  & A ~ (x B)
  & f1 ~ (B C)

@reciprocal = (n (f A))
  & n ~ (A f) // root

@mult = (m (n (f B)))
  & n ~ (f A)
  & m ~ (A B)

@main = oneish
  & @succ ~ (@id {two0 two1})
  & @reciprocal ~ (two0 half)
  & @mult ~ (half multHalf)
  & multHalf ~ (two1 oneish)

// This might be eta-equivalent to one?
