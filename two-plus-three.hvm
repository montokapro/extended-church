@id = (x x)

@succ = (n ({f0 f1} (x C)))
  & n ~ (f0 A)
  & A ~ (x B)
  & f1 ~ (B C)

@plus = (m (n (f (x D))))
  & f ~ {f0 f1}
  & n ~ (f0 A)
  & A ~ (x B)
  & m ~ (f1 C)
  & C ~ (B D)

@main = five
  & @succ ~ (@id {two0 two1})
  & @succ ~ (two0 three)
  & @plus ~ (two1 plusTwo)
  & plusTwo ~ (three five)

