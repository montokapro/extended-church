@id = (x x)

@succ = (n ({f0 f1} (x C)))
  & n ~ (f0 A)
  & A ~ (x B)
  & f1 ~ (B C)

@reciprocal = (n (f A))
  & n ~ (A f) // root

@plus = (m (n (f (x D))))
  & f ~ {f0 f1}
  & n ~ (f0 A)
  & A ~ (x B)
  & m ~ (f1 C)
  & C ~ (B D)

@main = oneish
  & @succ ~ (@id two)
  & @reciprocal ~ (two {half0 half1})
  & @plus ~ (half0 plusHalf)
  & plusHalf ~ (half1 oneish)

