@conId = (x x)

@succ = (n ({f0 f1} (x C)))
  & n ~ (f0 A)
  & A ~ (x B)
  & f1 ~ (B C)

@mult = (m (n (f B)))
  & n ~ (f A)
  & m ~ (A B)

@main = doubleConId
  & @succ ~ (@conId two)
  & @mult ~ (two double)
  & double ~ (@conId doubleConId)

