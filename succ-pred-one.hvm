@id = (x x)

@pred = (n ({f0 f1} (x C)))
  & n ~ (f0 A)
  & A ~ (x B)
  & f1 ~ (C B)

@succ = (n ({f0 f1} (x C)))
  & n ~ (f0 A)
  & A ~ (x B)
  & f1 ~ (B C)

@main = oneish
  & @pred ~ (@id zeroish)
  & @succ ~ (zeroish oneish)

