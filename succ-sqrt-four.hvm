@id = (x x)

@succ = (n ({f0 f1} (x C)))
  & n ~ (f0 A)
  & A ~ (x B)
  & f1 ~ (B C)

@main = threeish
  & @succ ~ (@id {two0 two1})
  & @succ ~ (two0 three)
  & @succ ~ (three four)
  & two1 ~ (sqrtFour four)
  & succ ~ (sqrtFour threeish)

