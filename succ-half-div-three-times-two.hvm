@id = (x x)

@succ = (n ({f0 f1} (x C)))
  & n ~ (f0 A)
  & A ~ (x B)
  & f1 ~ (B C)

@reciprocal = (n (f A))
  & n ~ (A f) // root

@mult = (m (n (f B)))
  & n ~ (f A)
  & m ~ (A B)

@div = (m (n (f B)))
  & n ~ (A f) // root
  & m ~ (A B)

@main = oneish
  & @succ ~ (@id {two0 {two1 two2}})
  & @reciprocal ~ (two0 half)
  & @succ ~ (half threeHalves)
  & @div ~ (threeHalves divThreeHalves)
  & @succ ~ (two1 three)
  & divThreeHalves ~ (three halfish)
  & @mult ~ (two2 multTwo)
  & multTwo ~ (halfish oneish)

// This might be eta-equivalent to one?
