@conId = (x x)

@succ = (n ({f0 f1} (x C)))
  & n ~ (f0 A)
  & A ~ (x B)
  & f1 ~ (B C)

@div = (m (n (f B)))
  & n ~ (A f) // root
  & m ~ (A B)

@main = halveConId
  & @succ ~ (@conId two)
  & @div ~ (two halve)
  & halve ~ (@conId halveConId)

